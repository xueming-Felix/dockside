# Agent Relay workspace key (agentrelay.com workspace settings)
RELAY_WORKSPACE_KEY=
# OpenAI key for the persona brains (gpt-5-mini)
OPENAI_API_KEY=

# Which dock backend: mock | terse
DOCK=mock
# Which bus: local | relay
BUS=local
# Which brain: rules | llm  (llm falls back to rules when OPENAI_API_KEY is unset)
BRAIN=rules

# Durable Actors actor id
DOCK_ACTOR_ID=pier9:2026-10-31
# OpenAI model for llmBrain
OPENAI_MODEL=gpt-5-mini

# Terse / durable-actors control plane (from `terse auth login`)
DURABLE_ACTORS_CONTROL_PLANE_URL=
DURABLE_ACTORS_TOKEN=

# `terse actor generate` writes relay/generated/ — the generated client reads
# these for actor calls and websocket grants. Placeholders until Person A deploys.
TERSE_ACTOR_URL=
TERSE_API_KEY=
