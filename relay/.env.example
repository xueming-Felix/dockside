# Agent Relay workspace key (agentrelay.com workspace settings)
RELAY_WORKSPACE_KEY=
# OpenAI key for the persona brains (gpt-5-mini)
OPENAI_API_KEY=

# Which dock backend: mock | terse
DOCK=mock
# Which bus: local | relay
BUS=local
# Which brain: rules | llm  (llm falls back to rules when OPENAI_API_KEY is unset)
BRAIN=rules

# Durable Actors actor id (letters, digits, '.', '-', '_' only — no ':')
DOCK_ACTOR_ID=pier9-2026-10-31
# OpenAI model for llmBrain
OPENAI_MODEL=gpt-5-mini

# Tuning (defaults in parentheses)
# RELAY_DEBUG=1            — per-message post/delivery latency logging
# THREAD_DEADLINE_MIN=10   — offer thread lifetime in sim minutes (10 real s at speed 1)
# AUCTION_CLOSE_MIN=10     — auction close delay in sim minutes
# AGENT_DELAY_MS=800,2000  — agent reply delay range in real ms

# Terse / durable-actors — `terse actor generate` writes relay/generated/ and the
# generated client reads these. The durable-actors runtime does NOT run on
# native Windows — use WSL 2 locally or Terse Cloud.
# Local dev control plane (generated client defaults to port 7100 if unset):
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7111
# Required for non-local control planes:
DURABLE_ACTORS_PROJECT_ID=
# Bearer token for Terse Cloud:
DURABLE_ACTORS_SECRET=
