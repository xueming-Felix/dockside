{
  "name": "dockside-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host 127.0.0.1",
    "server": "bun --watch server.ts",
    "build": "vite build",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit",
    "start:cloud": "bash -c 'set -a; source ../actor/.env.cloud; set +a; bun server.ts'",
    "server:cloud": "bash -c 'set -a; source ../actor/.env.cloud; set +a; bun --watch server.ts'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
